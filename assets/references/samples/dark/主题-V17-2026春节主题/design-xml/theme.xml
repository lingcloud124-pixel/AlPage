<?xml version="1.0" encoding="UTF-8"?>
<root xmlns="http://www.landray.com.cn/schema/lui" xmlns:degign="http://www.landray.com.cn/schema/design"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
	http://www.landray.com.cn/schema/lui../../../sys/ui/lui.xsd
	http://www.landray.com.cn/schema/design../../../design-xml.xsd">
	<theme id="$themeId$" name="$themeName$" path="/ui-ext/$themeId$/" thumb="/ui-ext/$themeId$/thumb.jpg">
    <style>

      <!-- 通用级样式 -->
      <css type="common" path="style/common.css"></css>

      <!-- 图标样式 -->
      <css type="icon" path="style/icon.css"></css>

      <!-- 如果不需要调整系统的字体图标不用要引入此样式 iconfont.css -->
      <!-- <css type="iconfont" path="style/iconfont.css"></css> -->

      <!-- 员工黄页样式 -->
      <css type="zone" path="style/zone.css"></css>

      <!-- 社区样式 -->
      <css type="sns" path="style/sns.css"></css>

      <!-- 门户样式 -->
      <css type="portal" path="style/portal.css"></css>

      <!-- 表单样式 -->
      <css type="form" path="style/form.css"></css>

      <!-- 后台管理样式 -->
      <css type="profile" path="style/profile.css"></css>

      <!-- 业务模块样式（所有业务模块的特有样式可以扔进此CSS） -->
      <css type="module" path="style/module.css"></css>

      <!-- 日历样式 -->
      <css type="calendar" path="style/calendar.css"></css>

      <!-- 未知样式 -->
      <!-- <css type="treefont" path="style/treefont.css"></css> -->

      <!-- 分步部件样式 -->
      <css type="step" path="style/step.css"></css>

      <!-- listview.css 包含 prompt list paging listview criteria -->
      <css type="listview" path="style/listview.css"></css>

      <!-- widget.css 包含 panel dataview popup toolbar menu -->
      <css type="widget" path="style/widget.css"></css>

      <!-- dialog.css 包含 category dialog address -->
      <css type="dialog" path="style/dialog.css"></css>
    </style>
	</theme>
</root>