  "outputFormats": {
    "ekp": {
      "format": "scss",
      "file": "scss/lib/vars.scss",
      "prefix": "$",
      "versions": {
        "v17": { "template": "v17/vars.scss.template" },
        "v14-v16": { "template": "v14-v16/vars.scss.template" },
        "v13": { "template": "v13/vars.scss.template" },
        "v12": { "template": "v12/vars.scss.template" }
      }
    },
    "mk": {
      "format": "css",
      "file": "style.css",
      "prefix": "--"
    },
    "kk": {
      "format": "json",
      "file": "config.json",
      "prefix": ""
    }
  },
  "automation": {
    "defaultEkpVersion": "v17",
    "fallbackStrategy": "useLatestVersion",
    "validation": {
      "checkVersionSupport": true,
      "checkVariableExists": true
    }
  }
}