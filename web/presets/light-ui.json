{
  "id": "light-ui",
  "name": "浅色主题",
  "description": "浅色背景主题，文字使用深色，默认通用主题风格",
  "gradientStart": "#fdfff5",
  "gradientMid": "#f7f3cd",
  "headerOpacities": {
    "default": 1.0,
    "classic": 0.5,
    "banner": 0.6,
    "sidebar": 1.0
  },
  "gradientWidths": {
    "leftSmall": 859,
    "rightSmall": 920,
    "leftLarge": 1145,
    "rightLarge": 1226
  },
  "defaults": {
    "primary-color": "#2C615C",
    "primary-color-hover": "#44978f",
    "alter-color": "#1c2725",
    "alter-color-hover-on": "#6bbdb4",
    "primary-color-opacity-10": "#eaefef",
    "primary-color-opacity-20": "#d5dfde",
    "primary-color-opacity-30": "#c0d0ce",
    "header-font-color": "#333333",
    "auxiliary-gray": "#999999",
    "auxiliary-gray-dark": "#666666",
    "body-bg-color": "#F8F8F8",
    "portal-header-bg-extend-color": "#FBFCF2",
    "portal-header-complex-bg-extend-color": "#FBFCF2",
    "login-bg-color": "#FDFFF6",
    "sidebar-panel-bg": "#FBFCF2",
    "sidebar-color": "#333333",
    "sidebar-icon-color": "#2C615C",
    "border-color": "#E5E7EB",
    "border-icon-color": "#E5E7EB",
    "gradient-start": "#FBFCF2",
    "gradient-mid": "#dfe7e7"
  },
  "colorRules": {
    "headerFontColor": "#333333",
    "opacityCalculation": "blendWhite(primary, percentage)",
    "alterCalculation": "desaturate(darken(primary, 15%), 20%)",
    "alterHoverCalculation": "lighten(primaryHover, 15%)",
    "lightnessOrder": "primaryHover > primary > alter > alterHover"
  }
}
