{
  "id": "dark-ui",
  "name": "Dark-UI 样例包",
  "description": "以 dark 样例包真实成品为母版，主色来自图片，其余颜色按 Pen 关系推导",
  "gradientStart": "#A7160B",
  "gradientMid": "#FDD0A3",
  "headerOpacities": {
    "default": 1.0,
    "classic": 0.5,
    "banner": 0.6,
    "sidebar": 1.0
  },
  "gradientWidths": {
    "leftSmall": 859,
    "rightSmall": 920,
    "leftLarge": 1145,
    "rightLarge": 1226
  },
  "defaults": {
    "primary-color": "#226F3B",
    "primary-color-hover": "#FDD0A3",
    "alter-color": "#94170E",
    "alter-color-hover-on": "#B9453C",
    "primary-color-opacity-10": "#F6E7E6",
    "primary-color-opacity-20": "#EDD0CE",
    "primary-color-opacity-30": "#E4B9B5",
    "header-font-color": "#FFE4CF",
    "auxiliary-gray": "#999999",
    "auxiliary-gray-dark": "#666666",
    "body-bg-color": "#F8F8F8",
    "portal-header-bg-extend-color": "#C41B00",
    "portal-header-complex-bg-extend-color": "#C41B00",
    "login-bg-color": "#C41B00",
    "sidebar-panel-bg": "#FFE4CF",
    "sidebar-color": "#333333",
    "sidebar-icon-color": "#DCB496",
    "border-color": "#EEEEEE",
    "border-icon-color": "#EEEEEE",
    "gradient-start": "#A7160B",
    "gradient-mid": "#FDD0A3"
  },
  "colorRules": {
    "primaryHoverOffset": "+26°",
    "primaryHoverLightness": "82%",
    "headerFontRule": "fixed #FFE4CF",
    "sidebarPanelBgEquals": "header-font-color",
    "portalHeaderRule": "primary hue +4°, saturation up, lightness ≈38-42%",
    "alterCalculation": "same hue, slightly darker than primary",
    "alterHoverCalculation": "same hue, lower saturation, lightness ≈48%",
    "lightnessOrder": "alter < primary < portalHeader <= alterHover < primaryHover < headerFont"
  }
}
