# Theme Studio runtime environment
# Real secrets are NOT committed. Production should provide these via the deployment platform.
# Model provider configuration (endpoint / model / api key) is managed in /admin and stored in SQLite.

PORT=3001
# 生产必须修改为强密码，不能为空
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# 仅本地桌面桥接模式使用；线上 SaaS 部署通常不需要
THEME_STUDIO_EXPORT_BRIDGE_PORT=8787

# Image generation (Jimeng 4.0 / 即梦 — highest priority when both set)
# JIMENG_ACCESS_KEY=
# JIMENG_SECRET_KEY=

# EKP SSO integration (同域部署)
EKP_BASE_URL=https://myekp.landray.com.cn
EKP_SSO_USER=
EKP_SSO_PASS=
# 如 EKP Token 解析接口路径变更，可覆盖默认值
EKP_TOKEN_RESOLVE_PATH=/sys/authentication/sso/loginService_rest/getTokenLoginName

# 仅本地开发使用；生产环境务必保持 false 或不配置
# ENABLE_DEV_AUTH=true
# DEV_LOGIN_NAME=dev_user

# 供服务端截图流程访问前端预览页使用；生产应改成你的正式域名
# SCREENSHOT_BASE_URL=https://your-domain.example.com

# 公网访问地址（用于 SSO 回调 URL 生成），部署到 HTTPS 环境时必须设置
# 否则 SSO 回调地址可能错误地使用 http:// 导致 EKP 拒绝回调
PUBLIC_BASE_URL=https://your-domain.example.com

# API Key 加密密钥（至少16位随机字符串），不设置则明文存储
# SECRET_ENCRYPTION_KEY=请用 openssl rand -hex 32 生成
